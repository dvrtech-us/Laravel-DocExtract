{
    "name": "dvrtech/laravel-docextract",
    "description": "Extract Markdown, text, and images from documents in Laravel by running the DocExtract executable.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "docextract", "pdf", "ocr", "markdown", "documents"],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dvrtech\\LaravelDocExtract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dvrtech\\LaravelDocExtract\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dvrtech\\LaravelDocExtract\\DocExtractServiceProvider"
            ],
            "aliases": {
                "DocExtract": "Dvrtech\\LaravelDocExtract\\Facades\\DocExtract"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
